# ================================= 前端环境变量模板（.env.example） ================================
# 说明：
# 1. 本地开发：复制此文件 → 重命名为 .env.development → 填写开发环境值
# 2. 测试环境：复制此文件 → 重命名为 .env.test → 填写测试服值（运维配置）
# 3. 生产环境：复制此文件 → 重命名为 .env.production → 填写正式服值（运维配置）
# 4. 所有变量名前缀：Vite项目用 VITE_，Webpack项目可自定义（如 REACT_APP_）

# -------------------------- 1. 接口配置（不同环境地址不同） --------------------------
# 开发环境：本地/内网开发服地址（如 http://192.168.1.100:8080/api）
# 测试环境：测试服地址（如 http://test-api.xxx.com/api）
# 生产环境：正式服地址（如 https://api.xxx.com/api）
VITE_API_BASE_URL=【填写对应环境的接口前缀，开发用内网地址】

# 接口超时时间（所有环境统一，无需修改）
VITE_API_TIMEOUT=5000

# 是否开启接口Mock（仅开发环境用true，测试/生产用false）
VITE_USE_MOCK=【开发填true，测试/生产填false】


# -------------------------- 2. 第三方SDK配置（不同环境密钥可能不同） --------------------------
# 百度地图SDK密钥（开发/测试用测试密钥，生产用正式密钥）
VITE_BAIDU_MAP_KEY=【开发填测试密钥：AkTest123；生产填正式密钥：AkProd456】

# Sentry错误监控（开发环境可留空，测试/生产填对应环境的DSN）
VITE_SENTRY_DSN=【开发填空；测试填 https://test-sentry.xxx.com/123；生产填 https://sentry.xxx.com/456】

# 埋点统计ID（开发用测试ID，生产用正式ID）
VITE_TRACK_PROJECT_ID=【开发填 test-track-001；生产填 prod-track-001】


# -------------------------- 3. 环境标识与功能开关（按环境固定值） --------------------------
# 环境标识（固定值：development=开发，test=测试，production=生产）
VITE_ENV=【开发填development，测试填test，生产填production】

# 调试面板开关（仅开发环境显示，测试/生产隐藏）
VITE_OPEN_DEBUG_PANEL=【开发填true，测试/生产填false】

# 日志打印开关（开发显示详细日志，生产关闭）
VITE_ENABLE_LOG=【开发填true，测试填true，生产填false】


# -------------------------- 4. 其他配置（所有环境统一） --------------------------
# 静态资源CDN地址（开发用本地，测试/生产用CDN）
VITE_CDN_BASE_URL=【开发填 /static；测试/生产填 https://cdn.xxx.com/static】

# 版本号（打包时自动注入，本地开发可填 0.0.1）
VITE_APP_VERSION=【开发填 0.0.1；打包时替换为 package.json 中的版本】