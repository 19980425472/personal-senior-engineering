

# -------------------------- 1. 环境变量文件（核心忽略） --------------------------
# 忽略所有真实环境变量文件（含敏感信息）
.env
.env.development
.env.test
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local

# 保留环境变量模板（不含敏感信息，必须提交）
!.env.example


# -------------------------- 2. 包管理器依赖（无需提交） --------------------------
# npm/yarn/pnpm 依赖目录（可通过 package.json 重新安装）
node_modules/
# pnpm 特有的依赖缓存目录
.pnpm-store/
# yarn 特有的缓存目录
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
# 依赖版本锁定文件（可选：建议提交，确保团队依赖版本一致）
# package-lock.json  # npm
# yarn.lock          # yarn
# pnpm-lock.yaml     # pnpm


# -------------------------- 3. 构建/打包产物（可重新生成） --------------------------
# 通用构建目录（Vue/Vite/React 常见）
dist/
build/
out/
# Vite 特有的产物目录
dist-ssr/
*.local
# React 特有的构建目录
build/
# Angular 特有的构建目录
dist/
# TypeScript 编译产物
lib/
es/
*.tsbuildinfo


# -------------------------- 4. 开发工具缓存/日志（临时文件） --------------------------
# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 缓存文件
.cache/
.eslintcache
# 测试相关缓存
coverage/
test-results/
*.spec.ts.snap


# -------------------------- 5. 编辑器/IDE 配置（避免团队冲突） --------------------------
# VS Code 配置
.vscode/
!.vscode/extensions.json  # 例外：团队统一插件配置
!.vscode/settings.json    # 例外：团队统一编辑器设置（可选）
# IntelliJ 系列（WebStorm 等）
.idea/
*.iml
*.iws
*.ipr
# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
# Atom 编辑器
.atom/
# Sublime Text
.sublime-project
.sublime-workspace
# Vim 编辑器临时文件
*.swp
*.swo


# -------------------------- 6. 操作系统相关文件（无需追踪） --------------------------
# Mac 系统
.DS_Store
# Windows 系统
Thumbs.db
~$*  # Office 临时文件


# -------------------------- 7. 其他前端相关文件 --------------------------
# 样式预处理器缓存
*.css.map
*.scss.map
*.less.map
.node-sass/
# 上传文件目录（用户上传的图片等，本地开发可能临时生成）
uploads/
assets/uploads/
# 压缩包/安装包（避免提交大文件）
*.zip
*.tar.gz
*.rar
*.7z
# 本地开发的临时脚本/文件（个人使用，不共享）
temp/
scripts/temp/
