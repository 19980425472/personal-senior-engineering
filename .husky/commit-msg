#!/bin/bash

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" | head -n1 | xargs)

echo "🔍 检测提交信息: '$COMMIT_MSG'"

# 如果是空信息或格式错误，启动引导
if [ -z "$COMMIT_MSG" ] || [[ ! "$COMMIT_MSG" =~ ^(feat|fix|docs|style|refactor|test|chore|perf) ]]; then
  echo "🎯 启动提交引导..."
  echo "-----------------------------------------------------------"
  
  # 启动引导工具并等待完成
  if node scripts/commit-guide.cjs; then
    echo "✅ 引导工具执行完成"
    exit 0
  else
    echo "❌ 引导工具执行失败"
    exit 1
  fi
fi

echo "🔍 提交信息格式正确，进行验证..."


# 否则用 commitlint 验证
pnpm dlx commitlint --edit "$COMMIT_MSG_FILE"


# 最后执行完应该执行一次 prettier，防止格式问题
pnpm dlx prettier --fix --write "$COMMIT_MSG_FILE"